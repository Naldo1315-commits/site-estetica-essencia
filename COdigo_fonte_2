
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#321b0e">
<meta name="description" content="Essência Estética e Bem-estar. Cuidados faciais, corporais, mãos, pés e massagens.">
<title>Essência | Estética & Bem-estar</title>

<style>
:root {
  --marrom: #321b0e;
  --dourado: #c88a2d;
  --dourado-claro: #f2c56d;
  --creme: #fff0df;
  --pessego: #f8d9c0;
  --texto: #3c2417;
  --whatsapp: #16a05a;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, sans-serif;
  background: var(--creme);
  color: var(--texto);
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

.container {
  width: 92%;
  max-width: 1160px;
  margin: auto;
}

/* CABEÇALHO */

header {
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 10;
  color: white;
  background: linear-gradient(#211006dd, transparent);
}

.nav {
  min-height: 100px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo img {
  width: 58px;
  height: 75px;
  object-fit: contain;
}

.logo strong {
  font-family: Georgia, serif;
  font-size: 30px;
  font-style: italic;
  color: var(--dourado-claro);
}

.logo small {
  display: block;
  text-align: center;
  letter-spacing: 3px;
  font-size: 10px;
}

nav {
  display: flex;
  gap: 24px;
}

nav a:hover {
  color: var(--dourado-claro);
}

.botao {
  display: inline-block;
  background: linear-gradient(110deg, #f5c56b, #c17a19);
  color: #321b0e;
  padding: 14px 23px;
  border-radius: 30px;
  font-weight: bold;
  transition: .3s;
}

.botao:hover {
  transform: translateY(-3px);
}

/* BANNER PRINCIPAL */

.hero {
  min-height: 570px;
  padding: 160px 0 70px;
  display: flex;
  align-items: center;
  color: white;
  background:
    linear-gradient(90deg, #351d10ed, #542e1870),
    url("hero-manicure.jpg") center/cover;
}

.hero-content {
  max-width: 560px;
}

.hero h1 {
  font-family: Georgia, serif;
  font-size: clamp(45px, 6vw, 76px);
  line-height: 1.1;
  margin: 20px 0;
}

.hero h1 em {
  color: var(--dourado-claro);
}

.hero p {
  font-size: 18px;
  margin-bottom: 28px;
}

/* SERVIÇOS */

.services {
  padding: 45px 0;
  background: linear-gradient(110deg, #f8dfc9, #ffeedd);
  border-radius: 0 0 35px 35px;
}

.section-title {
  text-align: center;
  margin-bottom: 30px;
}

.section-title h2 {
  font-family: Georgia, serif;
  font-size: 38px;
  font-weight: normal;
}

.cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.card {
  background: #fff7ee;
  border-radius: 18px;
  padding: 25px 15px;
  text-align: center;
  transition: .3s;
}

.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 25px #6e3a1720;
}

.card .icon {
  font-size: 38px;
  color: var(--dourado);
}

.card h3 {
  font-family: Georgia, serif;
  margin: 10px 0;
}

/* SOBRE NÓS */

.about {
  padding: 85px 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
}

.about h2 {
  font: normal 42px Georgia, serif;
  margin-bottom: 20px;
}

.about p {
  margin-bottom: 15px;
  color: #755b49;
}

.about-image {
  min-height: 320px;
  border-radius: 25px;
  background: linear-gradient(135deg, #f4c9a8, #fff0df);
  display: grid;
  place-items: center;
}

.about-image img {
  width: 55%;
  max-height: 280px;
  object-fit: contain;
}

/* GALERIA */

.gallery {
  background: linear-gradient(#f9dfc9, #fff0df);
  padding: 75px 0;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.gallery-grid img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  border-radius: 17px;
}

/* CONTATO */

.contact {
  padding: 45px 0;
  background: #f2d2b8;
}

.contact-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  text-align: center;
}

/* CHAMADA FINAL */

.final {
  background: linear-gradient(120deg, #4a2714, #2b170d);
  color: white;
  padding: 70px 20px;
  text-align: center;
}

.final h2 {
  font: normal 38px Georgia, serif;
  margin: 15px auto;
  max-width: 800px;
}

.final p {
  margin-bottom: 25px;
  color: #f0d6bd;
}

/* RODAPÉ */

footer {
  background: #241208;
  color: #f8e7d3;
  text-align: center;
  padding: 30px 15px;
  border-top: 1px solid var(--dourado);
}

/* WHATSAPP FIXO */

.whatsapp {
  position: fixed;
  right: 22px;
  bottom: 20px;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--whatsapp);
  color: white;
  padding: 14px 20px;
  border-radius: 35px;
  font-weight: bold;
  box-shadow: 0 8px 25px #0004;
}

.whatsapp:hover {
  background: #0d8147;
}

/* RESPONSIVIDADE */

@media(max-width: 850px) {
  nav {
    gap: 12px;
    font-size: 13px;
  }

  .cards,
  .gallery-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media(max-width: 600px) {
  nav {
    display: none;
  }

  .hero {
    min-height: 570px;
  }

  .about {
    grid-template-columns: 1fr;
  }

  .cards {
    grid-template-columns: repeat(2, 1fr);
  }

  .gallery-grid img {
    height: 140px;
  }

  .contact-grid {
    grid-template-columns: 1fr;
  }

  .whatsapp {
    right: 12px;
    bottom: 12px;
    padding: 12px 15px;
  }
}
</style>
</head>

<body>

<header>
  <div class="container nav">
    <a class="logo" href="#inicio">
      <img src="logo-coelho-dourado.jpg" alt="Logo Essência">
      <span>
        <strong>Essência</strong>
        <small>ESTÉTICA & BEM-ESTAR</small>
      </span>
    </a>

    <nav>
      <a href="#inicio">Início</a>
      <a href="#sobre">Sobre Nós</a>
      <a href="#servicos">Serviços</a>
      <a href="#galeria">Galeria</a>
      <a href="#contato">Contato</a>
    </nav>

    <a class="botao" data-whatsapp href="#">
      Agende seu horário
    </a>
  </div>
</header>

<main>

<section class="hero" id="inicio">
  <div class="container hero-content">
    <h1>Sua <em>beleza</em>,<br>nosso cuidado!</h1>

    <p>
      Realce o que há de mais lindo em você
      com tratamentos estéticos personalizados,
      em um ambiente acolhedor e profissional.
    </p>

    <a href="#" data-whatsapp class="botao">
      Conheça mais →
    </a>
  </div>
</section>

<section class="services" id="servicos">
  <div class="container">
    <div class="section-title">
      <h2>Cuidado em cada detalhe</h2>
      <p>Nossos serviços</p>
    </div>

    <div class="cards">

      <a href="#" data-whatsapp class="card">
        <div class="icon">♧</div>
        <h3>Estética Facial</h3>
        <p>Saiba mais →</p>
      </a>

      <a href="#" data-whatsapp class="card">
        <div class="icon">♙</div>
        <h3>Tratamentos Corporais</h3>
        <p>Saiba mais →</p>
      </a>

      <a href="#" data-whatsapp class="card">
        <div class="icon">♡</div>
        <h3>Mãos e Pés</h3>
        <p>Saiba mais →</p>
      </a>

      <a href="#" data-whatsapp class="card">
        <div class="icon">❀</div>
        <h3>Massagens</h3>
        <p>Saiba mais →</p>
      </a>

    </div>
  </div>
</section>

<section class="container about" id="sobre">

  <div>
    <h2>Sobre a <em>Essência</em></h2>

    <p>
      Somos mais que estética. Somos autocuidado,
      bem-estar e autoestima.
    </p>

    <p>
      Aqui, cada mulher é acolhida em sua beleza única,
      com respeito à diversidade e atenção às suas necessidades.
    </p>

    <a href="#" data-whatsapp class="botao">
      Conheça nossa equipe →
    </a>
  </div>

  <div class="about-image">
    <img src="logo-coelho-dourado.jpg" alt="Identidade visual Essência">
  </div>

</section>

<section class="gallery" id="galeria">
  <div class="container">

    <div class="section-title">
      <h2>Nossa Galeria</h2>
      <p>Beleza e bem-estar em cada detalhe</p>
    </div>

    <div class="gallery-grid">
      <img src="galeria-maos.jpg" alt="Cuidados com unhas das mãos">
      <img src="galeria-facial.jpg" alt="Tratamento facial">
      <img src="galeria-pes.jpg" alt="Cuidados com os pés">
      <img src="galeria-massagem.jpg" alt="Massagem relaxante">
    </div>

  </div>
</section>

<section class="contact" id="contato">
  <div class="container contact-grid">

    <div>
      <h3>Fale conosco</h3>
      <p>Atendimento pelo WhatsApp</p>
    </div>

    <div>
      <h3>Horários</h3>
      <p>Segunda a sábado — sob agendamento</p>
    </div>

    <div>
      <h3>Localização</h3>
      <p>Endereço a definir</p>
    </div>

  </div>
</section>

<section class="final">
  <div class="container">
    <h2>Conheça nosso trabalho e descubra o cuidado que combina com você.</h2>

    <p>
      Tire suas dúvidas e consulte nossos horários.
      Será um prazer receber você.
    </p>

    <a href="#" data-whatsapp class="botao">
      Fale conosco no WhatsApp →
    </a>
  </div>
</section>

</main>

<footer>
  <h2>Essência</h2>
  <p>Estética & Bem-estar</p>
  <small>© 2026 Essência. Todos os direitos reservados.</small>
</footer>

<a href="#" data-whatsapp class="whatsapp">
  ◉ Fale conosco no WhatsApp
</a>

<script>
/* CONFIGURAÇÃO DO WHATSAPP */

const WHATSAPP_NUMBER = "55SEUNUMERO";

const WHATSAPP_MESSAGE =
  "Olá! Gostaria de conhecer os serviços da Essência e consultar horários para agendamento.";

const whatsappURL =
  "https://wa.me/" +
  WHATSAPP_NUMBER +
  "?text=" +
  encodeURIComponent(WHATSAPP_MESSAGE);

document.querySelectorAll("[data-whatsapp]").forEach(button => {
  button.href = whatsappURL;
  button.target = "_blank";
  button.rel = "noopener noreferrer";
});
</script>

</body>
</html>
